{
    "enabled": true,
    "features": {
        "users": true,
        "events": true,
        "groups": true,
        "profiles": true
    },
    "apiPrefix": "/devtools",
    "randomData": {
        "defaults": {
            "users": 10,
            "profiles": 10,
            "events": 20,
            "groups": 5
        },
        "tables": {
