{
  "private": "true",
  "name": "server-app",
  "types": "module",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "build": "mkdir -p certs && mkdir -p tmp",
    "build:certs": "mkdir -p certs && openssl req -x509 -newkey rsa:4096 -nodes -keyout certs/server.key -out certs/server.crt -subj \"/CN=meet.online\" -days 365",
    "lint": "./node_modules/.bin/eslint .",
    "lint:fix": "./node_modules/.bin/eslint . --fix",
    "test:jest": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" ./node_modules/.bin/jest --runInBand",
    "test": "npm run build && npm run test:jest",
    "test:jest:watch": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" ./node_modules/.bin/jest --runInBand --watch",
    "cover:jest": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" ./node_modules/.bin/jest --runInBand --coverage",
    "cover": "npm run cover:jest",
    "start": "npm run build && NODE_ENV=production node src/server.js",
    "dev": "npm run build && NODE_ENV=development DB_HOST=localhost node src/server.js",
    "dev:certs": "npm run build && npm run build:certs && NODE_ENV=development DB_HOST=localhost node src/server.js"
  },
  "keywords": [],
  "author": "wtasg",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@wtasnorg/node-lib": "^0.0.5",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-azure-ad": "^4.3.5",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@jest/globals": "^30.2.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}
