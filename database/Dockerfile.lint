FROM python:3.12-slim

# Install sqlfluff
# Note: The --trusted-host flags are used for environments with SSL certificate issues
# (e.g., corporate proxies, self-signed certificates). In production environments
# with proper SSL certificates, these flags can be removed.
RUN pip install --no-cache-dir \
    --trusted-host pypi.org \
    --trusted-host pypi.python.org \
    --trusted-host files.pythonhosted.org \
    sqlfluff==3.5.0

# Set working directory
WORKDIR /workspace

# Default command is to show help
CMD ["sqlfluff", "--help"]
