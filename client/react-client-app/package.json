{
  "name": "react-client-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --port ${E2E_PORT:-5180} --host",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "npx eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build:certs": "mkdir -p .cert && openssl req -x509 -newkey rsa:2048 -nodes -keyout .cert/key.pem -out .cert/cert.pem -subj \"/CN=localhost\" -days 365",
    "e2e": "NODE_EXTRA_CA_CERTS=./.cert/cert.pem npx playwright test",
    "e2e:docker": "echo 'NOTE: This script is intended for containerized environments where cleanup is handled by the container lifecycle.' && npm run dev:e2e & sleep 5 && NODE_EXTRA_CA_CERTS=./.cert/cert.pem npx playwright test --reporter=list"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.5",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "playwright": "^1.56.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.5"
  }
}