#
# MeetOnline Project .gitignore
# Scoped to: Node.js, React (Vite), SQLite, Playwright, Docker
#

## mine
.changes/*.md
*.tmp

##
## Project-specific
##

# Database files
*.sqlite3
*.db
build_db

# HTTPS/SSL certificates and keys
https-keys/
*.cert
*.pem
*.pfx
*.p12
*.key
*.crt

# Server uploads and images
server/node-server-app/uploads/
server/node-server-app/images/

# Build artifacts
*.out
*.exe

##
## Node.js / npm
##

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# npm cache
.npm

# TypeScript cache
*.tsbuildinfo

# Optional eslint/stylelint cache
.eslintcache
.stylelintcache

# dotenv environment variable files
.env
.env.*
!.env.example

##
## Vite / React
##

dist/
dist-ssr/
*.local

##
## Playwright Testing
##

**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/
**/playwright/.auth/

##
## SQL linting
##

.sqlfluff_cache/

##
## IDE / Editor
##

# JetBrains (IntelliJ, WebStorm)
.idea/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Vim
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags
[._]*.un~

##
## OS-specific
##

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

##
## Build tools
##

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
cmake-build-*/
Makefile

##
## Misc
##

# Obsidian/Logseq note-taking
**/.obsidian/appearance.json
**/.obsidian/graph.json
**/.obsidian/workspace.json
.logseq/

# Coverage reports
coverage/
*.lcov
.nyc_output/
coverage.txt

# Ruby bundler (if used)
.bundle/
